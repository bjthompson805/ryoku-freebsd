#!/bin/sh
# The one root entry point the desktop uses. install.sh puts it at
# /usr/local/libexec/ryoku-priv, root-owned, and grants the login user
# passwordless doas/sudo for this file only, so every action here must be
# fixed: no argument reaches a command line unvalidated.
#
#   ryoku-priv lid S3|S4|S5|NONE   what closing the lid does
#   ryoku-priv webcam on|off       start or stop webcamd and keep it that way
#   ryoku-priv pkg-update          refresh the package catalogue, so the
#                                  background update check sees new versions
#   ryoku-priv wifi on|off         bring every Wi-Fi interface up or down
#   ryoku-priv wifi-powersave off|on
#                                  game mode: keep the Wi-Fi radio awake, then
#                                  restore the power save it had before
#   ryoku-priv hotspot up|down     share the default route over Wi-Fi; up
#                                  reads the network name and the password
#                                  from stdin, one line each
#   ryoku-priv charge-limit on|off|set <50-100>|full-when-off on|off
#                                  battery charge limit (ASUS firmware)
#   ryoku-priv charge-limit probe|apply|release
#                                  check for support (install.sh), apply at
#                                  boot, lift to 100% at shutdown if opted in
#   ryoku-priv power-profile saver|balanced|performance
#                                  powerd's AC and battery modes, kept in
#                                  rc.conf so they outlive a reboot
#   ryoku-priv bt pair <addr> <name>
#                                  remember a device for hcsecd, PIN 0000
#   ryoku-priv bt forget <addr>    undo pair, audio and hid for a device
#   ryoku-priv bt audio on|off <addr>
#                                  A2DP playback through a virtual_oss
#                                  profile, kept in rc.conf across reboots
#   ryoku-priv bt hid on|off <addr>
#                                  keyboard or mouse through bthidd
#   ryoku-priv bt power on|off     attach or detach the adapter's driver
set -eu

# rc.d runs this with rc's PATH, which leaves out /usr/local, where
# acpi_call and the other packaged tools live.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH

ps_prev=/var/run/ryoku-wifi-powersave.prev

# the hotspot is an access-point clone of the Wi-Fi device, renamed so the
# station-side code (which looks for wlan*) never mistakes it for the uplink.
# hostapd runs WPA2 on it, dnsmasq hands out addresses and DNS, and pf NATs
# the clients out the default route. everything it started is recorded in
# hs_dir, so down undoes exactly that.
hs_dir=/var/run/ryoku-hotspot
hs_if=ryokuap0
hs_net=10.42.0

hotspot_down() {
  for p in dnsmasq hostapd; do
    if [ -r "$hs_dir/$p.pid" ]; then kill "$(cat "$hs_dir/$p.pid")" 2>/dev/null || true; fi
  done
  if [ -e "$hs_dir/pf-owned" ]; then
    pfctl -q -F all 2>/dev/null || true
    pfctl -q -d 2>/dev/null || true
  elif [ -e "$hs_dir/pf-anchor" ]; then
    pfctl -q -a ryoku-hotspot -F all 2>/dev/null || true
  fi
  if [ -r "$hs_dir/forwarding" ]; then
    sysctl net.inet.ip.forwarding="$(cat "$hs_dir/forwarding")" >/dev/null || true
  fi
  ifconfig "$hs_if" destroy 2>/dev/null || true
  rm -rf "$hs_dir"
}

hotspot_fail() {
  echo "$*" >&2
  hotspot_down
  exit 1
}

hotspot_up() {
  export LC_ALL=C
  IFS= read -r name || true
  IFS= read -r pw || true
  case "$name" in ""|*[[:cntrl:]]*) hotspot_fail "the network name is empty or has control characters" ;; esac
  [ ${#name} -le 32 ] || hotspot_fail "the network name is longer than 32 bytes"
  case "$pw" in *[![:print:]]*) hotspot_fail "the password must be printable ASCII" ;; esac
  [ ${#pw} -ge 8 ] && [ ${#pw} -le 63 ] || hotspot_fail "the password must be 8 to 63 characters"

  ext=$(route -n get default 2>/dev/null | awk '$1 == "interface:" { print $2 }')
  case "$ext" in ""|*[!a-zA-Z0-9.]*) hotspot_fail "there is no internet connection to share" ;; esac
  parent=$(sysctl -n net.wlan.devices 2>/dev/null | awk '{ print $1 }')
  [ -n "$parent" ] || hotspot_fail "there is no Wi-Fi device"

  hotspot_down
  mkdir -m 755 "$hs_dir"

  # an access point and a station on one radio must share its channel.
  chan=6
  for i in $(ifconfig -g wlan); do
    if ifconfig "$i" | grep -q 'status: associated'; then
      c=$(ifconfig "$i" | sed -nE 's/.*[[:space:]]channel ([0-9]+) .*/\1/p' | head -1)
      [ -n "$c" ] && chan=$c && break
    fi
  done
  mode=g
  [ "$chan" -gt 14 ] && mode=a

  new=$(ifconfig wlan create wlandev "$parent" wlanmode hostap 2>/dev/null) ||
    hotspot_fail "$parent cannot run an access point"
  ifconfig "$new" name "$hs_if" >/dev/null
  ifconfig "$hs_if" inet "$hs_net.1/24" up

  ssid=$(printf %s "$name" | od -An -v -tx1 | tr -d ' \n')
  (
    umask 077
    printf '%s\n' "interface=$hs_if" driver=bsd "ssid2=$ssid" "hw_mode=$mode" "channel=$chan" \
      wpa=2 wpa_key_mgmt=WPA-PSK rsn_pairwise=CCMP "wpa_passphrase=$pw" >"$hs_dir/hostapd.conf"
  )
  hostapd -B -P "$hs_dir/hostapd.pid" "$hs_dir/hostapd.conf" >/dev/null 2>&1 ||
    hotspot_fail "hostapd could not start the access point"
  dnsmasq --conf-file=/dev/null --interface="$hs_if" --except-interface=lo0 --bind-interfaces \
    --dhcp-range="$hs_net.10,$hs_net.200,12h" --dhcp-leasefile="$hs_dir/leases" \
    --pid-file="$hs_dir/dnsmasq.pid" ||
    hotspot_fail "dnsmasq could not start"

  sysctl -n net.inet.ip.forwarding >"$hs_dir/forwarding"
  sysctl net.inet.ip.forwarding=1 >/dev/null

  # pf already running means the user has rules of their own: load into an
  # anchor they reference rather than replacing them.
  nat="nat on $ext inet from $hs_net.0/24 to any -> ($ext)"
  if pfctl -s info 2>/dev/null | grep -q 'Status: Enabled'; then
    pfctl -s Anchors 2>/dev/null | grep -q ryoku-hotspot ||
      hotspot_fail 'pf is running with your own rules: add nat-anchor "ryoku-hotspot" and anchor "ryoku-hotspot" to /etc/pf.conf'
    printf '%s\n' "$nat" | pfctl -q -a ryoku-hotspot -f - || hotspot_fail "pf rejected the NAT rule"
    : >"$hs_dir/pf-anchor"
  else
    kldload -n pf
    : >"$hs_dir/pf-owned"
    printf '%s\npass all\n' "$nat" | pfctl -q -f - || hotspot_fail "pf rejected the NAT rule"
    pfctl -q -e
  fi
}

# the charge limit goes through ASUS's WMI method on \_SB.ATKD, the call
# Linux's asus-wmi makes: DSTS (status) or DEVS (set) on device 0x00120057,
# the battery's RSOC. the firmware reports support, not the current limit,
# and forgets the limit at power-off, so the setting lives in cl_state,
# world-readable for ryoku-charge-limit's status, and boot re-applies it.
cl_state=/var/db/ryoku-charge-limit
cl_method='\_SB.ATKD.WMNB'
cl_dsts=1398035268  # 0x53545344
cl_devs=1398162756  # 0x53564544

# key from cl_state, else the default in $2.
cl_get() {
  v=$(awk -v k="$1" '$1 == k { print $2 }' "$cl_state" 2>/dev/null) || v=
  echo "${v:-$2}"
}

# rewrite cl_state with one key changed.
cl_put() {
  supported=$(cl_get supported false) enabled=$(cl_get enabled false)
  end=$(cl_get end 80) full_when_off=$(cl_get full_when_off false)
  eval "$1=\$2"
  printf 'supported %s\nenabled %s\nend %s\nfull_when_off %s\n' \
    "$supported" "$enabled" "$end" "$full_when_off" >"$cl_state.tmp"
  chmod 644 "$cl_state.tmp"
  mv -f "$cl_state.tmp" "$cl_state"
}

# one WMNB call on the RSOC device with a 32-bit argument; prints the result.
cl_call() {
  kldload -n acpi_call 2>/dev/null || return 1
  acpi_call -p "$cl_method" -i 0 -i "$1" \
    -b "57001200$(printf '%02x' "$2")000000000000000000000000000000" -o i 2>/dev/null
}

# write a limit to the firmware; it answers 1 when it took it.
cl_write() {
  [ "$(cl_get supported false)" = true ] || { echo "this battery has no charge limit" >&2; exit 1; }
  [ "$(cl_call "$cl_devs" "$1")" = 1 ] || { echo "the firmware refused the charge limit" >&2; exit 1; }
}

charge_limit() {
  case "${1:-} ${2:-}" in
    "probe ")
      if [ "$(cl_call "$cl_dsts" 0)" = 1 ]; then cl_put supported true; else cl_put supported false; fi
      ;;
    "on ")
      cl_write "$(cl_get end 80)"
      cl_put enabled true
      ;;
    "off ")
      cl_write 100
      cl_put enabled false
      ;;
    "set "*)
      case "$2" in [5-9][0-9]|100) ;; *) echo "the limit must be 50 to 100" >&2; exit 2 ;; esac
      [ "$(cl_get enabled false)" = true ] && cl_write "$2"
      cl_put end "$2"
      ;;
    "full-when-off on")
      cl_put full_when_off true
      ;;
    "full-when-off off")
      cl_put full_when_off false
      ;;
    "apply ")
      if [ "$(cl_get enabled false)" = true ]; then cl_write "$(cl_get end 80)"; fi
      ;;
    "release ")
      if [ "$(cl_get enabled false)" = true ] && [ "$(cl_get full_when_off false)" = true ]; then
        cl_write 100
      fi
      ;;
    *)
      sed -n '7,34p' "$0" >&2
      exit 2
      ;;
  esac
}

# Bluetooth on FreeBSD's own stack. hcsecd answers PIN and link key
# requests, so a device is paired once it has an hcsecd.conf block; the
# hosts file names it and is the world-readable record of what is paired.
# The stack has no Secure Simple Pairing, so devices fall back to legacy
# PIN pairing, and headsets take 0000. Audio is a virtual_oss profile per
# device ("bt" plus the address's last six digits, which also serves as
# the hosts alias, since virtual_oss rejects long device names), serving
# /dev/dsp.<profile>; ryoku-shell gives PipeWire a sink for it.
bt_hosts=/etc/bluetooth/hosts
bt_sec=/etc/bluetooth/hcsecd.conf
bt_keys=/var/db/hcsecd.keys
bt_hid=/etc/bluetooth/bthidd.conf
bt_off=/var/run/ryoku-bt.off

bt_addr() {
  case "$1" in
    [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
    *) echo "not a Bluetooth address: $1" >&2; exit 2 ;;
  esac
}

bt_profile() {
  echo "bt$(echo "$1" | tr -d : | cut -c7-12)"
}

# drop every `device { ... }` block for one address from an hcsecd or
# bthidd config; both use that block layout.
bt_drop_block() {
  [ -f "$2" ] || return 0
  awk -v a="$1" '
    /^[ \t]*device[ \t]*\{/ { blk = $0 "\n"; inblk = 1; hit = 0; next }
    inblk {
      blk = blk $0 "\n"
      if (tolower($0) ~ "bdaddr[ \t]+" a) hit = 1
      if ($0 ~ /^[ \t]*\}/) { if (!hit) printf "%s", blk; inblk = 0 }
      next
    }
    { print }
  ' "$2" >"$2.tmp"
  chmod "$(stat -f %Lp "$2")" "$2.tmp"
  mv -f "$2.tmp" "$2"
}

bt_service_on() {
  sysrc "${1}_enable=YES" >/dev/null
  service "$1" restart >/dev/null 2>&1 || service "$1" start >/dev/null
}

bt_audio() {
  p=$(bt_profile "$2")
  case "$1" in
    on)
      kldload -n cuse
      configs=$(sysrc -n virtual_oss_configs 2>/dev/null || true)
      case " $configs " in *" $p "*) ;; *) configs="${configs:+$configs }$p" ;; esac
      # -R /dev/null: headsets have no A2DP source; their mic is on the
      # Handsfree profile, which virtual_oss does not speak.
      sysrc virtual_oss_enable=YES virtual_oss_configs="$configs" \
        "virtual_oss_$p=-C 2 -c 2 -r 48000 -b 16 -s 4ms -R /dev/null -P /dev/bluetooth/$p -d dsp.$p" >/dev/null
      [ -f "/var/run/virtual_oss/$p.pid" ] && kill -0 "$(cat "/var/run/virtual_oss/$p.pid")" 2>/dev/null ||
        service virtual_oss start "$p" >/dev/null
      ;;
    off)
      if [ -f "/var/run/virtual_oss/$p.pid" ]; then
        service virtual_oss stop "$p" >/dev/null 2>&1 || true
      fi
      configs=$(sysrc -n virtual_oss_configs 2>/dev/null || true)
      configs=$(echo " $configs " | sed "s/ $p / /g; s/^ *//; s/ *\$//")
      sysrc virtual_oss_configs="$configs" >/dev/null
      sysrc -x "virtual_oss_$p" 2>/dev/null || true
      ;;
  esac
}

bt_hid_cmd() {
  case "$1" in
    on)
      if ! grep -qi "bdaddr[[:space:]]*$2" "$bt_hid" 2>/dev/null; then
        q=$(bthidcontrol -a "$2" query) || { echo "the device did not answer the HID query" >&2; exit 1; }
        printf '%s\n' "$q" >>"$bt_hid"
      fi
      bt_service_on bthidd
      ;;
    off)
      bt_drop_block "$2" "$bt_hid"
      service bthidd status >/dev/null 2>&1 && service bthidd restart >/dev/null
      ;;
  esac
}

bt_cmd() {
  case "${1:-} ${2:-}" in
    "pair "*)
      bt_addr "$2"
      name=$(printf '%s' "${3:-}" | tr -c 'A-Za-z0-9_-' _ | cut -c1-40)
      [ -n "$name" ] || name=$(bt_profile "$2")
      p=$(bt_profile "$2")
      grep -vi "^$2[[:space:]]" "$bt_hosts" >"$bt_hosts.tmp" || true
      printf '%s\t%s %s\n' "$2" "$name" "$p" >>"$bt_hosts.tmp"
      chmod 644 "$bt_hosts.tmp"
      mv -f "$bt_hosts.tmp" "$bt_hosts"
      bt_drop_block "$2" "$bt_sec"
      printf '\ndevice {\n\tbdaddr\t%s;\n\tname\t"%s";\n\tkey\tnokey;\n\tpin\t"0000";\n}\n' \
        "$2" "$name" >>"$bt_sec"
      chmod 600 "$bt_sec"
      bt_service_on hcsecd
      bt_service_on sdpd
      ;;
    "forget "*)
      bt_addr "$2"
      bt_audio off "$2"
      bt_hid_cmd off "$2"
      bt_drop_block "$2" "$bt_sec"
      if [ -f "$bt_keys" ]; then
        grep -vi "^$2[[:space:]]" "$bt_keys" >"$bt_keys.tmp" || true
        chmod 600 "$bt_keys.tmp"
        mv -f "$bt_keys.tmp" "$bt_keys"
      fi
      grep -vi "^$2[[:space:]]" "$bt_hosts" >"$bt_hosts.tmp" || true
      chmod 644 "$bt_hosts.tmp"
      mv -f "$bt_hosts.tmp" "$bt_hosts"
      service hcsecd status >/dev/null 2>&1 && service hcsecd restart >/dev/null
      ;;
    "audio on"|"audio off")
      bt_addr "${3:-}"
      bt_audio "$2" "$3"
      ;;
    "hid on"|"hid off")
      bt_addr "${3:-}"
      bt_hid_cmd "$2" "$3"
      ;;
    # power works on the driver: detaching ng_ubt takes the HCI node away
    # and the radio with it. The marker tells ryoku-shell the adapter is
    # there but off, since nothing else is left to show it.
    # A detached device drops out of sysctl, so the marker also lists the
    # units power on has to bring back.
    "power off")
      units=$(sysctl -N dev.ubt 2>/dev/null | sed -n 's/^dev\.ubt\.\([0-9]*\)\.%parent$/ubt\1/p')
      printf '%s\n' $units >>"$bt_off"
      for u in $units; do devctl disable "$u" 2>/dev/null || true; done
      ;;
    "power on")
      if [ -f "$bt_off" ]; then
        while read -r u; do
          case "$u" in ubt[0-9]*) devctl enable "$u" 2>/dev/null || true ;; esac
        done <"$bt_off"
      fi
      rm -f "$bt_off"
      ;;
    *)
      sed -n '7,34p' "$0" >&2
      exit 2
      ;;
  esac
}

case "${1:-} ${2:-}" in
  "bt "*)
    shift
    [ $# -le 3 ] || { sed -n '7,34p' "$0" >&2; exit 2; }
    bt_cmd "$@"
    ;;
  "power-profile saver"|"power-profile balanced"|"power-profile performance")
    # balanced is powerd's own default: hiadaptive on AC, adaptive on battery.
    # PowerMode.qml matches these exact strings to light the right tab.
    case "$2" in
      saver) flags="-a adaptive -b minimum" ;;
      balanced) flags="" ;;
      performance) flags="-a maximum -b hiadaptive" ;;
    esac
    sysrc powerd_enable=YES powerd_flags="$flags" >/dev/null
    service powerd restart >/dev/null 2>&1 || service powerd start >/dev/null
    ;;
  "charge-limit "*)
    shift
    [ $# -le 2 ] || { sed -n '7,34p' "$0" >&2; exit 2; }
    charge_limit "$@"
    ;;
  "hotspot up")
    hotspot_up
    ;;
  "hotspot down")
    hotspot_down
    ;;
  "wifi on")
    for i in $(ifconfig -g wlan); do ifconfig "$i" up; done
    ;;
  "wifi off")
    for i in $(ifconfig -g wlan); do ifconfig "$i" down; done
    ;;
  "wifi-powersave off")
    : >"$ps_prev"
    for i in $(ifconfig -g wlan); do
      ifconfig -v "$i" | grep -q 'powersavemode PSP' && echo "$i" >>"$ps_prev"
      ifconfig "$i" -powersave || true
    done
    ;;
  "wifi-powersave on")
    if [ -r "$ps_prev" ]; then
      while read -r i; do
        case "$i" in wlan[0-9]*) ifconfig "$i" powersave || true ;; esac
      done <"$ps_prev"
    fi
    rm -f "$ps_prev"
    ;;
  "pkg-update ")
    exec pkg update -q
    ;;
  "lid S3"|"lid S4"|"lid S5"|"lid NONE")
    sysctl hw.acpi.lid_switch_state="$2" >/dev/null
    ;;
  "webcam on")
    sysrc webcamd_enable=YES >/dev/null
    service webcamd start
    ;;
  "webcam off")
    sysrc webcamd_enable=NO >/dev/null
    service webcamd onestop 2>/dev/null || true
    pkill -x webcamd 2>/dev/null || true
    ;;
  *)
    sed -n '7,34p' "$0" >&2
    exit 2
    ;;
esac
