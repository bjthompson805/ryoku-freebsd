#!/bin/sh
# The one root entry point the desktop uses. install.sh puts it at
# /usr/local/libexec/ryoku-priv, root-owned, and grants the login user
# passwordless doas/sudo for this file only, so every action here must be
# fixed: no argument reaches a command line unvalidated.
#
#   ryoku-priv lid S3|S4|S5|NONE   what closing the lid does
#   ryoku-priv webcam on|off       start or stop webcamd and keep it that way
#   ryoku-priv pkg-update          refresh the package catalogue, so the
#                                  background update check sees new versions
#   ryoku-priv wifi on|off         bring every Wi-Fi interface up or down
#   ryoku-priv wifi-powersave off|on
#                                  game mode: keep the Wi-Fi radio awake, then
#                                  restore the power save it had before
set -eu

ps_prev=/var/run/ryoku-wifi-powersave.prev

case "${1:-} ${2:-}" in
  "wifi on")
    for i in $(ifconfig -g wlan); do ifconfig "$i" up; done
    ;;
  "wifi off")
    for i in $(ifconfig -g wlan); do ifconfig "$i" down; done
    ;;
  "wifi-powersave off")
    : >"$ps_prev"
    for i in $(ifconfig -g wlan); do
      ifconfig -v "$i" | grep -q 'powersavemode PSP' && echo "$i" >>"$ps_prev"
      ifconfig "$i" -powersave || true
    done
    ;;
  "wifi-powersave on")
    if [ -r "$ps_prev" ]; then
      while read -r i; do
        case "$i" in wlan[0-9]*) ifconfig "$i" powersave || true ;; esac
      done <"$ps_prev"
    fi
    rm -f "$ps_prev"
    ;;
  "pkg-update ")
    exec pkg update -q
    ;;
  "lid S3"|"lid S4"|"lid S5"|"lid NONE")
    sysctl hw.acpi.lid_switch_state="$2" >/dev/null
    ;;
  "webcam on")
    sysrc webcamd_enable=YES >/dev/null
    service webcamd start
    ;;
  "webcam off")
    sysrc webcamd_enable=NO >/dev/null
    service webcamd onestop 2>/dev/null || true
    pkill -x webcamd 2>/dev/null || true
    ;;
  *)
    sed -n '7,14p' "$0" >&2
    exit 2
    ;;
esac
