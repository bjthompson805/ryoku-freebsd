#!/usr/bin/env bash
# extended sysread for the Ryoku Hub Profile dossier (stat sheet next to the
# specimen card). one field per line, exact order SysInfo.qml's extended parser
# wants. each field falls back to "-" or "" if its source is gone, so the panel
# degrades cleanly. separate from ryoku-sysinfo so the pill's 30s poll stays light.
export LC_ALL=C

read -r _ l1 _ < <(sysctl -n vm.loadavg)

# CPU temp from amdtemp/coretemp, else the first ACPI thermal zone.
temp="-"
t=$(sysctl -n dev.cpu.0.temperature 2>/dev/null || sysctl -n hw.acpi.thermal.tz0.temperature 2>/dev/null)
t=${t%C}
[ -n "$t" ] && temp="${t%%.*}°"

# battery %, if there is one.
bat="-"
[ "$(sysctl -n hw.acpi.battery.units 2>/dev/null)" -gt 0 ] 2>/dev/null &&
    bat="$(sysctl -n hw.acpi.battery.life)%"

# wallust palette, comma-joined, for the swatch strip.
palette=""
cj="${XDG_CACHE_HOME:-$HOME/.cache}/wallust/colors.json"
if [ -s "$cj" ] && command -v jq >/dev/null 2>&1; then
    palette=$(jq -r '[.color0,.color1,.color2,.color3,.color4,.color5,.color6,.color7,.color8,.color9,.color10,.color11,.color12,.color13,.color14,.color15]|join(",")' "$cj" 2>/dev/null)
fi

printf '%s\n' "$l1"
printf '%s\n' "$temp"
ps -ax -o pid= 2>/dev/null | wc -l
swapinfo -k 2>/dev/null | awk 'NR > 1 && $1 != "Total" { t += $2; u += $3 }
    END { if (t > 0) printf "%d%%\n", u / t * 100; else print "off" }'
printf '%s\n' "$bat"
hyprctl version 2>/dev/null | sed -nE '1s/^Hyprland ([0-9][0-9.]*).*/\1/p'
hyprctl monitors 2>/dev/null | grep -c '^Monitor'
# explicitly installed from a repo, then anything installed outside one
# (stash .pkg files), which pkg reports as unknown-repository.
pkg query -e '%a = 0' %R 2>/dev/null | grep -vc '^unknown-repository$'
pkg query %R 2>/dev/null | grep -c '^unknown-repository$'
printf '%s\n' "${XCURSOR_THEME:--}${XCURSOR_SIZE:+ · $XCURSOR_SIZE}"
printf '%s\n' "$palette"
