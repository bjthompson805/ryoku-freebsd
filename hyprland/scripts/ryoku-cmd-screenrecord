#!/bin/sh
# The shell's screen recorder: wf-recorder, hardware-encoded through VAAPI
# with a CPU fallback, into ~/Videos/Recordings.
#
#   ryoku-cmd-screenrecord [--fullscreen|--region] [--geometry WxH+X+Y]
#                          [--with-desktop-audio] [--with-microphone-audio]
#   ryoku-cmd-screenrecord -r|-s|-sr        region / desktop audio / both
#   ryoku-cmd-screenrecord --stop|--status|--info
#   ryoku-cmd-screenrecord                  start, or stop a running one
#
# Settings come from ~/.config/ryoku/recording.json (the Hub's Recording page):
# fps, quality, codec (h264|hevc|av1), encoder (gpu|cpu). RYOKU_SCREENRECORD_*
# env vars of the same names override them.
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku"
region_pick="$state_dir/region-pick"
recordings="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
pattern='(^|/)wf-recorder( |$)'

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a ryoku "$@" >/dev/null 2>&1; return 0; }

cfg() { # key default
  v=$(jq -r ".$1 // empty" "${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/recording.json" 2>/dev/null)
  printf '%s' "${v:-$2}"
}

running() { pgrep -f "$pattern" >/dev/null 2>&1; }

render_node() {
  if [ -n "${RYOKU_SCREENRECORD_DEVICE:-}" ]; then printf '%s' "$RYOKU_SCREENRECORD_DEVICE"; return; fi
  for n in /dev/dri/renderD*; do [ -e "$n" ] && { printf '%s' "$n"; return; }; done
}

# hardware and software encoder names for a codec.
hw_codec() { case "$1" in hevc) echo hevc_vaapi ;; av1) echo av1_vaapi ;; *) echo h264_vaapi ;; esac; }
sw_codec() { case "$1" in hevc) echo libx265 ;; av1) echo libsvtav1 ;; *) echo libx264 ;; esac; }

# quality preset -> VAAPI qp / software crf (lower = crisper). SVT-AV1's crf
# scale runs higher for the same look.
qp_for() { case "$1" in ultra) echo 16 ;; very_high) echo 20 ;; high) echo 24 ;; *) echo 28 ;; esac; }
crf_for() {
  c=$(case "$1" in ultra) echo 17 ;; very_high) echo 20 ;; high) echo 23 ;; *) echo 28 ;; esac)
  [ "$2" = av1 ] && c=$((c + 10))
  echo "$c"
}

focused_output() {
  hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused)][0].name // .[0].name // empty' 2>/dev/null
}

# region as wf-recorder's "X,Y WxH": an explicit --geometry, else the box the
# island's picker drew (consumed so it is never reused stale), else slurp.
region() {
  g="$geometry"
  if [ -z "$g" ] && [ -s "$region_pick" ]; then
    g=$(tr -d '[:space:]' <"$region_pick")
    rm -f "$region_pick"
  fi
  if [ -n "$g" ]; then
    echo "$g" | sed -nE 's/^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$/\3,\4 \1x\2/p'
  else
    slurp 2>/dev/null
  fi
}

next_path() {
  base="$recordings/recording_$(date +%Y-%m-%d_%H.%M.%S)"
  p="$base.mp4"
  i=1
  while [ -e "$p" ]; do p="$base-$i.mp4"; i=$((i + 1)); done
  printf '%s' "$p"
}

start() {
  if running; then notify "Screen recording" "A recording is already running"; return 0; fi
  command -v wf-recorder >/dev/null 2>&1 || { notify -u critical "Screen recording failed" "wf-recorder is not installed"; exit 1; }

  fps="${RYOKU_SCREENRECORD_FPS:-$(cfg fps 60)}"
  quality="${RYOKU_SCREENRECORD_QUALITY:-$(cfg quality very_high)}"
  codec="${RYOKU_SCREENRECORD_CODEC:-$(cfg codec h264)}"
  encoder="${RYOKU_SCREENRECORD_ENCODER:-$(cfg encoder gpu)}"

  set -- -r "$fps"
  if [ "$mode" = region ]; then
    g=$(region)
    [ -n "$g" ] || exit 0
    set -- "$@" -g "$g"
  else
    out=$(focused_output)
    [ -n "$out" ] && set -- "$@" -o "$out"
  fi

  # wf-recorder takes one audio device; desktop audio wins when both are asked.
  dev=""
  if [ "$desktop_audio" = 1 ]; then
    dev=$(pactl get-default-sink 2>/dev/null) && dev="$dev.monitor"
  elif [ "$mic_audio" = 1 ]; then
    dev=$(pactl get-default-source 2>/dev/null)
  fi
  if [ "$desktop_audio" = 1 ] || [ "$mic_audio" = 1 ]; then
    if [ -n "$dev" ]; then set -- "$@" --audio="$dev"; else set -- "$@" --audio; fi
  fi

  mkdir -p "$recordings"
  file=$(next_path)

  # VAAPI first. if the encoder can't come up it exits within a moment, and
  # the recording restarts on the CPU encoder so a file always lands.
  node=$(render_node)
  if [ "$encoder" = gpu ] && [ -n "$node" ]; then
    wf-recorder "$@" -c "$(hw_codec "$codec")" -d "$node" -p qp="$(qp_for "$quality")" \
      -F scale_vaapi=format=nv12 -f "$file" &
    pid=$!
    sleep 1.5
    if kill -0 "$pid" 2>/dev/null; then wait "$pid"; exit $?; fi
    wait "$pid"
    [ -s "$file" ] && exit 0
    rm -f "$file"
  fi
  exec wf-recorder "$@" -c "$(sw_codec "$codec")" -p crf="$(crf_for "$quality" "$codec")" -f "$file"
}

stop() {
  if ! running; then notify "Screen recording" "No active recording found"; return 0; fi
  pkill -INT -f "$pattern"
  notify "Screen recording stopped" "Saved to Videos/Recordings"
}

info() {
  codec="${RYOKU_SCREENRECORD_CODEC:-$(cfg codec h264)}"
  if [ "${RYOKU_SCREENRECORD_ENCODER:-$(cfg encoder gpu)}" = gpu ] && [ -n "$(render_node)" ]; then
    enc="VAAPI $(hw_codec "$codec") on $(render_node)"
  else
    enc="CPU $(sw_codec "$codec")"
  fi
  printf '{"backend":"wf","encoder":"%s"}\n' "$enc"
}

action=auto
mode=fullscreen
geometry=""
desktop_audio=0
mic_audio=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fullscreen) mode=fullscreen; action=start ;;
    --region|-r) mode=region; action=start ;;
    -s) desktop_audio=1; action=start ;;
    -sr|-rs) mode=region; desktop_audio=1; action=start ;;
    --with-desktop-audio) desktop_audio=1; action=start ;;
    --with-microphone-audio) mic_audio=1; action=start ;;
    --geometry) shift; geometry="${1:-}" ;;
    --stop|stop) action=stop ;;
    --status|status) action=status ;;
    --info|info) action=info ;;
    -h|--help|help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "ryoku-cmd-screenrecord: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

[ "$action" = auto ] && { if running; then action=stop; else action=start; fi; }
case "$action" in
  start)  start ;;
  stop)   stop ;;
  status) if running; then echo recording; else echo idle; fi ;;
  info)   info ;;
esac
