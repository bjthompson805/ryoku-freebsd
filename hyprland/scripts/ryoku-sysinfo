#!/usr/bin/env bash
# sysread for the pill's SYSTEM card. one field per line, exact order SysInfo.qml
# parses. dual-GPU aware: matches device classes (not bus ids), strips the
# bus/class prefix and vendor noise. first run rolls a random codename and saves
# it to ~/.local/state/ryoku/codename, so the operator handle stays stable
# across reboots for this install.
export LC_ALL=C

clean_gpu() {
    sed -E 's/NVIDIA Corporation //; s/Advanced Micro Devices, Inc\. //; s/Intel Corporation //; s/\[AMD\/ATI\] //; s/.*\[([^]]+)\].*/\1/' | xargs | cut -c1-30
}

# pciconf -lv prints each device's vendor/device lines before its class line.
gpus=$(pciconf -lv 2>/dev/null | awk -F"'" '/^[^ \t]/{d=""} /device +=/{d=$2} /class +=.*display/{print d}')
gpu1=$(printf '%s\n' "$gpus" | sed -n '1p' | clean_gpu)
gpu2=$(printf '%s\n' "$gpus" | sed -n '2p' | clean_gpu)

cf="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku/codename"
if [ ! -s "$cf" ]; then
    mkdir -p "$(dirname "$cf")"
    names=(VESPER ONYX KESTREL CIPHER NOVA EMBER RONIN ZENITH OBSIDIAN HALCYON \
           VANTA KAIROS AZRAEL SABLE FENRIR ORACLE PHANTOM VECTOR RIFT ECHO \
           FLUX NEXUS QUASAR PULSAR COBALT SPECTRE VORTEX ZEPHYR AXIOM BASTION \
           DRIFT ETHER GLITCH HAVOC IGNIS KARMA LUMEN MIRAGE NOCTIS OMEN \
           PRISM QUILL RAVEN SOLACE TEMPEST UMBRA VIGIL WRAITH XENON ZEALOT \
           BLAZE CRUX DUSK FORGE GRIM HELIX ION JADE LYNX MAZE \
           NOMAD ODIN PYRE QUARTZ RUNE STYX TALON VOID WARP ZERO \
           ARGON BOREAL CINDER DELTA FABLE GOSSAMER HOLLOW INDIGO JUNO KITE)
    printf '%s\n' "${names[$((RANDOM % ${#names[@]}))]}" > "$cf"
fi
codename=$(cat "$cf")

whoami
cat /etc/hostname 2>/dev/null || hostname
grep -m1 'PRETTY_NAME' /etc/os-release 2>/dev/null | cut -d'"' -f2
uname -m
uname -r
echo "${SHELL##*/}"
sysctl -n hw.model | sed 's/ *@ .*//; s/([^)]*)//; s/ w\/.*//' | xargs | cut -c1-26
echo "$(sysctl -n kern.smp.cores)C / $(sysctl -n hw.ncpu)T"
echo "${gpu1:--}"
echo "$gpu2"
# used = physmem minus free, inactive and the ZFS ARC (released on demand),
# the same sum the bar's memory meter uses.
sysctl -n hw.physmem hw.pagesize vm.stats.vm.v_free_count vm.stats.vm.v_inactive_count \
    kstat.zfs.misc.arcstats.size 2>/dev/null | xargs | awk '
    function si(b) { return b >= 1e9 ? sprintf("%.1fG", b / 1e9) : sprintf("%dM", b / 1e6) }
    { used = $1 - ($3 + $4) * $2 - $5; if (used < 0) used = 0
      print si(used) " / " si($1); print int(used / $1 * 100) }'
df -h / | awk 'NR==2{print $3" / "$2}'
df / | awk 'NR==2{print int($3/($3+$4)*100)}'
boot=$(sysctl -n kern.boottime | sed -E 's/.*sec = ([0-9]+),.*/\1/')
up=$(($(date +%s) - boot))
echo "$((up / 3600))h $((up % 3600 / 60))m"
pkg query %n 2>/dev/null | wc -l
hyprctl monitors 2>/dev/null | sed -nE 's/^[[:space:]]*([0-9]+x[0-9]+)@.*/\1/p' | head -1
hyprctl monitors 2>/dev/null | sed -nE 's/^[[:space:]]*[0-9]+x[0-9]+@([0-9]+).*/\1Hz/p' | head -1
echo "$codename"
